# Only definitions and public contracts belong in Git. Runner packages ALL files,
# including ignored files; review its inventory before submission.
/*/*
!/*/manifest.json
!/*/brief.md
!/*/AGENTS.md
!/*/inputs/
/*/inputs/*
!/*/inputs/question.md
!/*/inputs/contracts.json
!/*/inputs/output-packaging.md

# Committed game specs and package templates. Private bytes stay out of both.
!/specs/
!/specs/**
!/templates/
!/templates/**

# Historical private imports contain deployment-specific briefs and tool pins.
# Keep the full workspaces local; publish only deliberately portable definitions.
/pacman-us/
/bomberman-us/
